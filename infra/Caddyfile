# 프로덕션 리버스 프록시 + 자동 HTTPS (Let's Encrypt)
# 로컬에서 테스트하려면: caddy run --config infra/Caddyfile
#
# 32.199.114.190.nip.io -> 이 EC2 의 탄력적 IP 로 resolve 되는 도메인.
# Caddy 가 80 포트로 ACME(HTTP-01) 인증을 받아 인증서를 자동 발급/갱신한다.
# 인증서는 caddy_data 볼륨에 저장되므로 컨테이너를 재생성해도 유지된다. (docker compose down -v 금지!)

32.199.114.190.nip.io {
	encode gzip

	# 멀티파트 업로드 + 정적 이미지만 post-service 직결 (/api 제거).
	# Spring Cloud Gateway 가 multipart 파일 파트를 제대로 전달 못 하고, Next BFF 로 재구성해 보내도 게이트웨이에서
	# 같은 문제가 나므로, 파일이 오가는 경로만 post-service 로 바로 보낸다.
	#   POST /api/posts            -> 글 작성(이미지 포함)
	#   POST /api/posts/{id}/images -> 수정 시 이미지 추가
	#   GET  /api/images/*          -> 저장된 이미지 서빙
	@postsvc_direct path /api/posts /api/posts/*/images /api/images/*
	handle @postsvc_direct {
		uri strip_prefix /api
		reverse_proxy post-service:8082
	}

	# 나머지 API 는 전부 Next BFF(route handler) 경유 — 쿠키의 access_token/user_email 을
	# Authorization / X-User-Email 헤더로 주입한 뒤 백엔드로 포워딩한다.
	# (프론트 컴포넌트들이 인증 헤더 없이 상대경로로 호출하는 BFF 우선 설계라, 직결하면 400/401)
	handle /api/posts/* {
		reverse_proxy frontend:3000
	}
	handle /api/fix-deals/* {
		reverse_proxy frontend:3000
	}
	handle /api/payments/* {
		reverse_proxy frontend:3000
	}
	# chat-rooms* : 뒤 경로 없는 목록 호출(/api/chat-rooms?page=..) 도 포함하도록 슬래시 없는 와일드카드
	handle /api/chat-rooms* {
		reverse_proxy frontend:3000
	}
	handle /api/chat/* {
		reverse_proxy frontend:3000
	}

	# 나머지 /api/* (auth, users) 는 게이트웨이 -> user-service
	handle /api/* {
		reverse_proxy api-gateway:8000
	}

	# STOMP WebSocket (채팅) -> post-service 직결. Caddy가 Upgrade 자동 처리.
	handle /ws/chat {
		reverse_proxy post-service:8082
	}

	# 소셜 로그인 진입/콜백
	handle /oauth2/authorization/* {
		reverse_proxy user-service:8081
	}
	handle /login/oauth2/* {
		reverse_proxy user-service:8081
	}

	# 그 외 전부 프론트엔드 (Next.js). WebSocket 업그레이드는 Caddy 가 자동 처리.
	handle {
		reverse_proxy frontend:3000
	}
}

# http 로 들어오면 Caddy 가 자동으로 https 로 301 리다이렉트 (기본 동작)
