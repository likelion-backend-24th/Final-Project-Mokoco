# 프로덕션 리버스 프록시 + 자동 HTTPS (Let's Encrypt)
# 로컬에서 테스트하려면: caddy run --config infra/Caddyfile
#
# 32.199.114.190.nip.io -> 이 EC2 의 탄력적 IP 로 resolve 되는 도메인.
# Caddy 가 80 포트로 ACME(HTTP-01) 인증을 받아 인증서를 자동 발급/갱신한다.
# 인증서는 caddy_data 볼륨에 저장되므로 컨테이너를 재생성해도 유지된다. (docker compose down -v 금지!)

32.199.114.190.nip.io {
	encode gzip

	# post-service (게시글/거래/이미지/제안) — API 게이트웨이 우회 직결.
	# Spring Cloud Gateway 가 multipart 파일 파트를 downstream 으로 제대로 전달하지 못하는 이슈 때문.
	# 컨트롤러 매핑이 /posts, /fix-deals, /images 이므로 /api 접두어는 제거한다.
	@postsvc path /api/posts /api/posts/* /api/fix-deals /api/fix-deals/* /api/images/* /api/proposals /api/proposals/*
	handle @postsvc {
		uri strip_prefix /api
		reverse_proxy post-service:8082
	}

	# 채팅: 컨트롤러가 이미 /api/chat-rooms 매핑이라 접두어 유지, post-service 직결
	handle /api/chat-rooms/* {
		reverse_proxy post-service:8082
	}

	# 나머지 /api/* (auth, users) 는 게이트웨이 -> user-service
	handle /api/* {
		reverse_proxy api-gateway:8000
	}

	# 소셜 로그인 진입/콜백
	handle /oauth2/authorization/* {
		reverse_proxy user-service:8081
	}
	handle /login/oauth2/* {
		reverse_proxy user-service:8081
	}

	# 그 외 전부 프론트엔드 (Next.js). WebSocket 업그레이드는 Caddy 가 자동 처리.
	handle {
		reverse_proxy frontend:3000
	}
}

# http 로 들어오면 Caddy 가 자동으로 https 로 301 리다이렉트 (기본 동작)
